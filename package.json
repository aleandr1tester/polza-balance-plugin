{
  "name": "dsh-polza-balance",
  "version": "0.5.2",
  "private": true,
  "description": "Overlay widget for the DSH Web GUI that shows the polza.ai balance, the spending limit for today and the total spent, read from the polza.ai MCP server.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
